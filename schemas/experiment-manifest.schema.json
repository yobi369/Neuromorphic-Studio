{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neuromorphic Studio Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["experimentId", "dataset", "split", "preprocessing", "seed", "model", "software", "sourceCommit"],
  "properties": {
    "experimentId": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "required": ["name", "version", "source", "license", "sha256", "sampleIdsSha256"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "source": {"type": "string"},
        "license": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "sampleIdsSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "split": {"enum": ["train", "validation", "test"]},
    "preprocessing": {"type": "object"},
    "seed": {"type": "integer", "minimum": 0},
    "model": {"type": "object", "required": ["name", "sha256", "parameters"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "parameters": {"type": "object"}}},
    "software": {"type": "object", "required": ["node", "python"], "properties": {"node": {"type": "string"}, "python": {"type": "string"}, "frameworks": {"type": "object"}}},
    "sourceCommit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "hardware": {"type": "object"},
    "metrics": {"type": "object"}
  }
}
