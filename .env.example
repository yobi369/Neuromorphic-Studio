# Optional: enables the server-side Gemini architecture assistant.
# Never expose this key in a VITE_* browser variable.
GEMINI_API_KEY=
# Express server port (defaults to 3000).
PORT=3000

# Required for accounts, private projects and experiment history.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to require only when your PostgreSQL provider requires TLS.
PGSSLMODE=require
